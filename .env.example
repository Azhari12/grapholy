# ============================================================
# Grapholy — Environment Variables (template)
# Salin file ini ke .env, lalu isi nilai Anda.
# JANGAN commit file .env yang sudah diisi.
# ============================================================

# ---- GitHub ----
# PAT (Personal Access Token) user. Scope minimal: repo:read (fine-grained lebih baik).
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- LLM Proxy lokal (Anthropic-compatible) ----
# Proxy jalan di localhost:1930, format Anthropic Messages API.
PROXY_URL=http://localhost:1930
PROXY_TOKEN=7561a54f81b5b69e126c62e32fd0b62d3747eca919ebfc2b
LLM_MODEL=claude-sonnet-4-5

# ---- Service ports ----
WEB_PORT=5174
API_PORT=3001
PYTHON_SERVICE_URL=http://localhost:8787
