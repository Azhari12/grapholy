# ============================================================
# Grapholy — Environment Variables (template)
# Salin file ini ke .env, lalu isi nilai Anda.
# JANGAN commit file .env yang sudah diisi.
# ============================================================

# ---- GitHub ----
# PAT (Personal Access Token). Scope minimal: repo:read (fine-grained lebih baik).
# Buat di: GitHub → Settings → Developer settings → Personal access tokens.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- LLM (opsional via .env; utamanya di-set via UI) ----
# AI settings utamanya disimpan di config/ai.local.json (bisa edit via UI).
# Field di bawah cuma dipakai sebagai DEFAULT kalau config local belum ada.
# Format: "openai" (untuk OpenAI/Mistral/Groq/Ollama) atau "anthropic"
LLM_FORMAT=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# ---- Service ports ----
WEB_PORT=5174
API_PORT=3001
PYTHON_SERVICE_URL=http://127.0.0.1:8787
